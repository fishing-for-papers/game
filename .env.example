# Cloudflare Worker URL for fish image generation
# Update this with your deployed worker URL after running: wrangler deploy
# For local development, use: http://localhost:8787
VITE_WORKER_URL=<your-worker-url>

# R2 Public Domain for direct image access
# This is the public domain of your R2 bucket (e.g., pub-xxxxx.r2.dev)
# You can find this in your Cloudflare dashboard under R2 > Your Bucket > Settings > Public Access
VITE_R2_PUBLIC_DOMAIN=<your-r2-pub-domain>
